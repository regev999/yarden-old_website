# On Proginter these are set in the Node.js app's environment variables, never in files.
# Postgres address of the site's database, e.g. postgres://user:pass@127.0.0.1:5432/db
DATABASE_URL=
# Folder for files uploaded in the admin, served at /files/… (default: ./storage next to the app)
UPLOAD_DIR=
# resend.com API key for lead notifications and password resets.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "האתר של ירדן כרם <site@yardenkerem.co.il>"
MAIL_FROM=
# One-time code for creating the first admin account at /admin/setup/
ADMIN_SETUP_KEY=
# Public address of the site (used in sitemaps, canonical links, emails)
SITE_URL=https://www.yardenkerem.co.il
# Set to 1 on a staging copy (e.g. a temporary subdomain) to keep it out of search engines
NOINDEX_ALL=
