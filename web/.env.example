# Filled in automatically when Neon is connected from the Vercel dashboard (Storage tab).
DATABASE_URL=
# Filled in automatically when a Blob store is connected (Storage tab).
BLOB_READ_WRITE_TOKEN=
# resend.com API key for lead notifications and password resets.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "האתר של ירדן כרם <site@yardenkerem.co.il>"
MAIL_FROM=
# One-time code for creating the first admin account at /admin/setup/
ADMIN_SETUP_KEY=
# Public address of the site (used in sitemaps, canonical links, emails)
SITE_URL=https://www.yardenkerem.co.il
